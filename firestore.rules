rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }

    // User profile & synced records — only the owner can read/write
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{store}/{recordId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Shared library books — anyone can read, only admins can change
    match /library_books/{bookId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
